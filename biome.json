{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!docs",
      "!spike",
      "!**/drizzle",
      "!**/.features-gen",
      "!**/*.gen.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.stryker-tmp",
      "!**/reports/mutation",
      "!**/tests/evals/fixtures/mcp-tools.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["tests/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": [
        "UPDATING.md",
        "scripts/docs-conformance/index.mjs",
        "scripts/docs-conformance/validators/claude-md-refs.mjs",
        "scripts/docs-conformance/validators/skill-web.mjs",
        "scripts/docs-conformance/validators/skill-paths.mjs",
        "scripts/docs-conformance/validators/mutation-decision.mjs",
        "scripts/docs-conformance/validators/design-brief.mjs",
        "scripts/docs-conformance/validators/housekeeping-due.mjs",
        "scripts/docs-conformance/validators/skill-bridge.mjs",
        "scripts/docs-conformance/validators/banned-words.mjs"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
